# Agent Arena Backend — Environment Variables
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5432/agent_arena

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PROGRAM_ID=GFnG5esZ77F4NL3CpSE9tLHG4ExghiQuBB83ZtGYuqcu
AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
TREASURY_KEYPAIR_PATH=
USDC_MINT=

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# OpenRouter (optional — for openrouter LLM provider)
OPENROUTER_API_KEY=

# Admin — required for admin endpoints (POST /admin/challenges, etc.)
ADMIN_API_KEY=

# Jupiter
JUPITER_API_URL=https://api.jup.ag

# Limits
MAX_SUBMISSIONS_PER_USER=3
QUOTE_MAX_AGE_SECS=30

# Debug
DEBUG=false
